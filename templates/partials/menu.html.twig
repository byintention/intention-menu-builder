{# Intention Menu Builder — default menu markup. Theme may override this partial. #}
{% macro render_items(items) %}
    {% import _self as menu %}
    {% for item in items %}
        {% if not item.missing %}
            {% set li_class = [] %}
            {% if item.active or item.active_child %}{% set li_class = li_class|merge(['active']) %}{% endif %}
            {% if item.children|length %}{% set li_class = li_class|merge(['menu-parent-item']) %}{% endif %}
            {% if item.external %}{% set li_class = li_class|merge(['external']) %}{% endif %}
            {% if item.classes %}{% set li_class = li_class|merge([item.classes]) %}{% endif %}
            <li{% if li_class %} class="{{ li_class|join(' ')|e('html_attr') }}"{% endif %}>
                <a href="{{ item.url|e }}"{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}{% if item.external %} class="external"{% endif %}>{{ item.title|e }}</a>
                {% if item.children|length %}
                    <ul class="sub-menu">
                        {{ menu.render_items(item.children) }}
                    </ul>
                {% endif %}
            </li>
        {% endif %}
    {% endfor %}
{% endmacro %}
{% import _self as menu %}
{% set wrap_nav = wrap_nav is defined ? wrap_nav : true %}
{% set nav_id = nav_id|default('') %}
{% set nav_class = nav_class|default('clearfix') %}
{% set ul_id = ul_id|default('') %}
{% set ul_class = ul_class|default('') %}
{% set items = items|default([]) %}
{% if wrap_nav %}
<nav{% if nav_id %} id="{{ nav_id|e('html_attr') }}"{% endif %}{% if nav_class %} class="{{ nav_class|e('html_attr') }}"{% endif %} data-menu="{{ menu_id|e('html_attr') }}">
{% endif %}
    <ul{% if ul_id %} id="{{ ul_id|e('html_attr') }}"{% endif %}{% if ul_class %} class="{{ ul_class|e('html_attr') }}"{% endif %}>
        {{ menu.render_items(items) }}
    </ul>
{% if wrap_nav %}
</nav>
{% endif %}
